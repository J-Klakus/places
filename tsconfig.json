{
  "extends": "astro/tsconfigs/strict",
  "include": [".astro/types.d.ts", "**/*"],
"exclude": [
    "dist"
],
"compilerOptions": {
    "types": [
    ],
    "baseUrl": ".",
    "paths": {
      "@components/*": ["src/components/*"],
      "@layouts/*": ["src/layouts/*"],
      "@assets/*": ["src/assets/*"],
      "@utils/*": ["utils/*"],
      "@db/*": ["src/db/*"]
    }
}
}
