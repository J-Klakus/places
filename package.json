{
  "name": "places",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro build && wrangler dev",
    "astro": "astro",
    "deploy": "astro build && wrangler deploy",
    "cf-typegen": "wrangler types",
    "db:migration": "npx drizzle-kit migrate",
    "db:gen": "npx drizzle-kit generate",
    "db:push": "npx drizzle-kit push",
    "migrate:remote": "npx wrangler d1 execute cfw-places-auth --remote",
    "migrate:local": "npx wrangler d1 execute cfw-places-auth --local"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^12.6.3",
    "@astrojs/svelte": "^7.1.0",
    "@azure-rest/ai-inference": "latest",
    "@azure/core-auth": "latest",
    "@azure/core-sse": "latest",
    "@cloudflare/puppeteer": "^1.0.4",
    "@iconify-json/heroicons": "^1.2.2",
    "@tailwindcss/vite": "^4.1.11",
    "@tarekraafat/autocomplete.js": "^10.2.9",
    "all-the-cities": "^3.1.0",
    "astro": "^5.12.9",
    "astro-icon": "^1.1.5",
    "better-auth": "^1.3.5",
    "cities.json": "^1.1.50",
    "cloudflare": "^4.5.0",
    "dotenv": "^17.2.1",
    "drizzle-orm": "^0.44.4",
    "flyonui": "^2.4.0",
    "iconify-icon": "^3.0.0",
    "puppeteer": "^24.16.1",
    "resend": "^6.0.1",
    "svelte": "^5.38.1",
    "tailwindcss": "^4.1.11",
    "typescript": "^5.9.2",
    "uuidv4": "^6.2.13"
  },
  "devDependencies": {
    "@playwright/test": "^1.54.2",
    "@tailwindcss/typography": "^0.5.16",
    "@types/node": "^24.2.1",
    "@zerodevx/svelte-toast": "^0.9.6",
    "drizzle-kit": "^0.31.4",
    "tsx": "^4.20.3",
    "wrangler": "^4.28.1"
  }
}
