    "@tarekraafat/autocomplete.js": "^10.2.9",
    "all-the-cities": "^3.1.0",
    "astro": "^5.7.4",
    "astro-icon": "^1.1.5",
    "better-auth": "^1.2.7",
    "cities.json": "^1.1.50",
    "dotenv": "^16.5.0",
    "drizzle-orm": "^0.42.0",
    "flyonui": "^2.1.0",
    "iconify-icon": "^2.3.0",
    "svelte": "^5.28.2",
    "tailwindcss": "^4.1.4",
    "typescript": "^5.8.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250422.0",
