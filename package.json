{
  "name": "places",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro build && wrangler dev",
    "astro": "astro",
    "deploy": "astro build && wrangler deploy",
    "cf-typegen": "wrangler types",
    "db:migration": "npx drizzle-kit migrate",
    "db:gen": "npx drizzle-kit generate",
    "db:push": "npx drizzle-kit push",
    "migrate:remote": "npx wrangler d1 execute cfw-places-auth --remote",
    "migrate:local": "npx wrangler d1 execute cfw-places-auth --local"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^12.5.2",
    "@astrojs/svelte": "^7.0.13",
    "@cloudflare/puppeteer": "^1.0.2",
    "@iconify-json/heroicons": "^1.2.2",
    "@tailwindcss/vite": "^4.1.5",
    "@tarekraafat/autocomplete.js": "^10.2.9",
    "all-the-cities": "^3.1.0",
    "astro": "^5.7.10",
    "astro-icon": "^1.1.5",
    "better-auth": "^1.2.7",
    "cities.json": "^1.1.50",
    "cloudflare": "^4.2.0",
    "dotenv": "^16.5.0",
    "drizzle-orm": "^0.43.1",
    "flyonui": "^2.1.0",
    "iconify-icon": "^3.0.0",
    "puppeteer": "^24.8.2",
    "svelte": "^5.28.2",
    "tailwindcss": "^4.1.5",
    "typescript": "^5.8.3",
    "uuidv4": "^6.2.13"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.16",
    "@types/node": "^22.15.3",
    "@zerodevx/svelte-toast": "^0.9.6",
    "drizzle-kit": "^0.31.1",
    "tsx": "^4.19.4",
    "wrangler": "^4.14.1"
  }
}
