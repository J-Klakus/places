---
import { Icon } from "astro-icon/components";
---

<dialog
  id="createMap"
  class="fixed inset-0 left-1/2 top-2 !mt-10 pb-10 w-screen overflow-visible -translate-x-1/2 translate-y-[5vh] transform rounded-xl p-4 opacity-0 shadow-lg backdrop-blur-lg transition-all duration-500 transition-discrete backdrop:bg-black/0 backdrop:backdrop-blur-lg transition:transform backdrop:transition-[overlay,display,opacity,transform] open:block open:translate-y-0 open:opacity-100 open:backdrop:bg-black/20 dark:open:backdrop:bg-neutral-700/20 open:starting:-translate-y-[5vh] open:starting:opacity-0 sm:w-1/2"
>
  <slot name="main" />
  <form method="dialog" id="create-place-form" class="space-y-4">
    <button
      type="button"
      id="close-dialog-button"
      class="z-50 float-right pb-4 text-neutral-400 hover:opacity-90 focus:outline-none"
      ><Icon name="heroicons:x-mark-16-solid" size={30} /></button
    >
    <h2 class="mt-2 w-full text-center text-xl font-bold sm:text-2xl">
      Create a map
    </h2>
    <div>
      <label for="name" class="block text-sm font-medium text-gray-700"
        >Place</label
      >
      <input
        type="text"
        id="name"
        name="name"
        placeholder="Search for Places..."
        autocomplete="off"
        minlength={3}
        maxlength={12}
        required
        class="mt-1 h-10 block w-full border border-gray-300 rounded-md shadow-sm py-2 px-3 focus:outline-none focus:ring-blue-500 focus:border-blue-500 sm:text-sm"
      />
    </div>
    <div class="flex gap-2">
      <div class="w-full">
        <label for="name" class="block text-sm font-medium text-gray-700"
          >Summary</label
        >
        <input
          type="text"
          id="summary"
          name="summary"
          placeholder="Summary"
          minlength={3}
          maxlength={33}
          required
          class="mt-1 h-10 block w-full border border-gray-300 rounded-md shadow-sm py-2 px-3 focus:outline-none focus:ring-blue-500 focus:border-blue-500 sm:text-sm"
        />
      </div>
      <div>
        <div class="flex flex-col items-center gap-1">
          <label
            class="label-text block text-sm font-medium text-gray-700"
            for="isPublic">Public</label
          >
          <input
            type="checkbox"
            class="checkbox"
            id="isPublic"
            name="isPublic"
            checked
          />
        </div>
      </div>
    </div>
    <div>
      <label for="description" class="block text-sm font-medium text-gray-700">
        Description
      </label>
      <div class="relative">
        <textarea
          id="description"
          name="description"
          minlength="100"
          maxlength="130"
          placeholder="Description"
          required
          class="mt-1 h-[3lh] block w-full border border-gray-300 rounded-md shadow-sm py-2 px-3 focus:outline-none focus:ring-blue-500 focus:border-blue-500 sm:text-sm"
        ></textarea>
        <button
          type="button"
          id="generate-description"
          class="absolute right-2 bottom-2 text-xs bg-gray-200 hover:bg-gray-300 px-2 py-1 rounded disabled:opacity-50 disabled:cursor-not-allowed"
          disabled
        >
          AI Generate
        </button>
      </div>
    </div>
    <div>
      <label for="link" class="block text-sm font-medium text-gray-700"
        >Link *Needs to be a google embed link</label
      >
      <input
        type="text"
        id="link"
        name="link"
        placeholder="https://www.google.com/maps/d/embed?mid=1yq6eTymPh_KJsqCAV1T_MM6_kdQ&ehbc=2E312F"
        required
        pattern="/^https:\/\/www\.google\.com\/maps\/d\/embed\?mid=[A-Za-z0-9_-]+.*$/"
        title="Please enter a valid Google Maps embed link"
        class="mt-1 h-10 block w-full border border-gray-300 rounded-md shadow-sm py-2 px-3 focus:outline-none focus:ring-blue-500 focus:border-blue-500 sm:text-sm"
      />
    </div>
    <div>
      <label for="tag" class="block text-sm font-medium text-gray-700"
        >Tag</label
      >
      <select
        id="tag"
        name="tag"
        class="mt-1 h-10 block w-full border border-gray-300 rounded-md shadow-sm py-2 px-3 focus:outline-none focus:ring-blue-500 focus:border-blue-500 sm:text-sm"
      >
        <option value="food">Food</option>
        <option value="accommodation">Accommodation</option>
        <option value="cafes-with-wifi">Cafes with Wifi</option>
        <option value="attractions">Attractions</option>
        <option value="mixed">Mixed</option>
      </select>
    </div>
    <button
      type="submit"
      class="w-full bg-blue-500 hover:bg-blue-700 text-white font-bold py-2 px-4 rounded-md shadow-md focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-opacity-50"
      >Create Place</button
    >
  </form>
</dialog>

<script>
  import { actions } from "astro:actions";
  import autoComplete from "@tarekraafat/autocomplete.js";

  const dialog = document.getElementById("createMap") as HTMLDialogElement;
  const form = document.getElementById("create-place-form") as HTMLFormElement;
  const closeButton = document.getElementById(
    "close-dialog-button"
  ) as HTMLButtonElement;

  if (closeButton) {
    closeButton.addEventListener("click", () => {
      dialog.close();
    });
  }

  const autoCompleteJS = new autoComplete({
    selector: "#name",
    placeHolder: "Search for Places...",
    data: {
      src: async (query: string) => {
        try {
          const { data, error } = await actions.getCity(query);
          return data;
        } catch (error) {
          return error;
        }
      },
    },
    resultItem: {
      highlight: true,
    },
    events: {
      input: {
        selection: (event: any) => {
          const selection = event.detail.selection.value;
          autoCompleteJS.input.value = selection;
        },
      },
    },
  });

  async function handleCreatePlace(event: Event) {
    event.preventDefault();
    const formData = new FormData(form);
    try {
      const response = await actions.createPlace({
        name: formData.get("name") as string,
        summary: formData.get("summary") as string,
        isPublic: Boolean(formData.get("isPublic")),
        description: formData.get("description") as string,
        link: formData.get("link") as string,
        tag: formData.get("tag") as
          | "food"
          | "accommodation"
          | "cafes-with-wifi"
          | "attractions"
          | "mixed",
      });

      if (!response.error) {
        const placeName = response.data?.name || "";
        console.log("Form Data:", Object.fromEntries(formData.entries()));
        form.reset();
        dialog.close();
      } else {
        const errorMessage = response.error || "Failed to create place.";
        console.error(errorMessage);
      }
    } catch (error: any) {
      const errorMessage = error.message || "An unexpected error occurred";
      console.error(errorMessage);
    }
  }

  if (form) {
    form.addEventListener("submit", handleCreatePlace);
  }

  // Get elements
const nameInput = document.getElementById("name") as HTMLInputElement;
const summaryInput = document.getElementById("summary") as HTMLInputElement;
const descriptionTextarea = document.getElementById("description") as HTMLTextAreaElement;
const generateButton = document.getElementById("generate-description") as HTMLButtonElement;

// Enable/disable AI button based on name and summary
function toggleGenerateButton() {
  const name = nameInput.value.trim();
  const summary = summaryInput.value.trim();
  generateButton.disabled = !(name && summary);
}

// Attach input listeners
nameInput.addEventListener("input", toggleGenerateButton);
summaryInput.addEventListener("input", toggleGenerateButton);

// Initial check
toggleGenerateButton();

// Handle AI description generation
generateButton.addEventListener("click", async () => {
  if (generateButton.disabled) return;

  const title = nameInput.value.trim();
  const summary = summaryInput.value.trim();

  generateButton.disabled = true;
  generateButton.textContent = "Generating...";

  try {
    const result = await actions.getDescription(title + " " + summary);

    if (result.data) {
      descriptionTextarea.value = result.data.trim();
      // Trigger input event so any validation/form state can react
      descriptionTextarea.dispatchEvent(new Event("input", { bubbles: true }));
    } else {
      console.error("AI Error:", result.error);
      alert("Failed to generate description: " + (result.error || "Unknown error"));
    }
  } catch (err) {
    console.error("Unexpected error:", err);
    alert("An unexpected error occurred while generating the description.");
  } finally {
    // Re-enable button
    generateButton.disabled = false;
    generateButton.textContent = "AI Generate";
  }
});
</script>
