---
import { Icon } from "astro-icon/components";
---

<dialog
    id="createMap"
    class="fixed inset-0 left-1/2 top-2 !mt-10 pb-10 w-screen overflow-visible -translate-x-1/2 translate-y-[5vh] transform rounded-xl p-4 opacity-0 shadow-lg backdrop-blur-lg transition-all duration-500 transition-discrete backdrop:bg-black backdrop:bg-black/0 backdrop:backdrop-blur-lg transition:transform backdrop:transition-[overlay,display,opacity,transform] duration-300 transition-discrete open:block open:translate-y-0 open:opacity-100 open:backdrop:bg-black/20 dark:open:backdrop:bg-neutral-700/20 open:starting:-translate-y-[5vh] open:starting:opacity-0 sm:w-1/2"
>
    <slot name="main" />
    <form method="dialog" id="create-place-form" class="space-y-4">
        <button
            type="button"
            id="close-dialog-button"
            class="z-50 float-right pb-4 text-neutral-400 hover:opacity-90 focus:outline-none"
        ><Icon name="heroicons:x-mark-16-solid" size={30} /></button
        >
        <h2 class="mt-2 w-full text-center text-xl font-bold sm:text-2xl">Create a map</h2>
        <div>
            <label for="name" class="block text-sm font-medium text-gray-700">Name</label>
            <input
                type="text"
                id="name"
                name="name"
                placeholder="Name"
                required
                class="mt-1 block w-full border border-gray-300 rounded-md shadow-sm py-2 px-3 focus:outline-none focus:ring-blue-500 focus:border-blue-500 sm:text-sm"
            />
        </div>
        <div>
            <label for="link" class="block text-sm font-medium text-gray-700">Link</label>
            <input
                type="text"
                id="link"
                name="link"
                placeholder="Link"
                required
                class="mt-1 block w-full border border-gray-300 rounded-md shadow-sm py-2 px-3 focus:outline-none focus:ring-blue-500 focus:border-blue-500 sm:text-sm"
            />
        </div>
        <div>
            <label for="tag" class="block text-sm font-medium text-gray-700">Tag</label>
            <select id="tag" name="tag" class="mt-1 block w-full border border-gray-300 rounded-md shadow-sm py-2 px-3 focus:outline-none focus:ring-blue-500 focus:border-blue-500 sm:text-sm">
                <option value="food">Food</option>
                <option value="accommodation">Accommodation</option>
                <option value="cafes-with-wifi">Cafes with Wifi</option>
                <option value="attractions">Attractions</option>
                <option value="mixed">Mixed</option>
            </select>
        </div>
        <button
            type="submit"
            class="w-full bg-blue-500 hover:bg-blue-700 text-white font-bold py-2 px-4 rounded-md shadow-md focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-opacity-50"
        >Create Place</button
        >
    </form>
</dialog>

<script>
import { actions } from "astro:actions";

const modals = document.querySelectorAll("dialog");
	modals.forEach((modal) => {
		modal.addEventListener("close", () => {
		  document.body.classList.remove('overflow-hidden')
	  });
	  modal.addEventListener("click", (event) => {
          if ((event.target as HTMLElement).nodeName === "DIALOG") {
            modal.close();
          }
		})
	})

    const dialog = document.getElementById("createMap") as HTMLDialogElement;
    const form = document.getElementById('create-place-form') as HTMLFormElement;
    const closeButton = document.getElementById('close-dialog-button') as HTMLButtonElement;

    if (closeButton) {
        closeButton.addEventListener('click', () => {
            dialog.close();
        });
    }

    async function handleCreatePlace(event: Event) {
        event.preventDefault();
        const formData = new FormData(form);
        try {
            const response = await actions.createPlace({
                name: formData.get('name') as string,
                link: formData.get('link') as string,
                tag: formData.get('tag') as "food" | "accommodation" | "cafes-with-wifi" | "attractions" | "mixed",
            });

            if (!response.error) {
                const placeName = response.data?.name || '';
                console.log(`Place created: ${placeName}`);
                form.reset();
                dialog.close();
            } else {
                const errorMessage = response.error || "Failed to create place.";
                console.error(errorMessage);
            }
        } catch (error: any) {
            const errorMessage = error.message || "An unexpected error occurred";
            console.error(errorMessage);
        }
    }


    if (form) {
        form.addEventListener('submit', handleCreatePlace);
    }
</script>
