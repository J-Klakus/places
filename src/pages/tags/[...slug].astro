---
import Layout from "@layouts/Layout.astro";
import Places from "@components/places.svelte";
import { actions } from "astro:actions";
if (!Astro.locals.user?.id) return Astro.redirect('/signin')

const user = Astro.locals.user;
const tag = Astro.params.slug || "";
if (tag !== "food" && tag !== "accommodation" && tag !== "cafes-with-wifi" && tag !== "attractions" && tag !== "mixed") return Astro.redirect('/404')
const { data, error } = await Astro.callAction(actions.getPlacesByTag, {tag: tag});
---

<Layout>
  <div class="mt-4 sm:mt-8 px-4 min-h-[50vh]">
    {tag && <h2 class="capitalize font-semibold !my-4">Maps tagged with {tag.replaceAll("-"," ")}</h2>}
    <Places places={data} userId={Astro.locals.user?.id} tag={tag} client:load />
  </div>
</Layout>