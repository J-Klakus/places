---
import Layout from "@layouts/Layout.astro";
import Places from "@components/places.svelte";
import { actions } from "astro:actions";
if (!Astro.locals.user?.id) return Astro.redirect('/signin')

const { data, error } = await Astro.callAction(actions.getTopPlaces, {});

---

<Layout>
  <div class="min-h-[50vh] px-4 2xl:px-0">
    <Places places={data} userId={Astro.locals.user?.id} client:load />
  </div>
</Layout>
